{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=${POSTGRES_HOST};Port=${POSTGRES_PORT};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD};Database=${POSTGRES_DB}"
  },
  "Captcha": {
    "CodeLength": 5,
    "TtlMinutes": 5,
    "Width": 200,
    "Height": 60,
    "FontFamily": "DejaVu Sans",
    "FontSize": 32
  },
  "FileStorage": {
    "UploadsPath": "/uploads"
  }
}